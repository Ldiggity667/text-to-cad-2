# Ollama server
OLLAMA_HOST=http://localhost:11434

# Models
# Code generation works best with a fast, non-reasoning model: it reliably
# returns a code block instead of stalling on internal "thinking".
TEXT_MODEL=llama3.2:latest
# Vision model, used to describe an uploaded image or drawing page.
VISION_MODEL=qwen3-vl:4b

# Paths (relative paths resolve against the project root)
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Generation behaviour
MAX_RETRIES=3
CODE_TIMEOUT_SECONDS=120

# Set to 1 to keep generated scripts in TEMP_DIR for debugging
FORGE3D_KEEP_TEMP=0
